# Optional: public commit games work without any environment variables or sign-in.
# Configure these only to enable host sign-in and private repository access.

# Canonical origin, with no path/query. HTTP is allowed only on localhost.
APP_URL=http://localhost:3000

# Register a GitHub OAuth App yourself:
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
# At least 32 characters; keep this private and stable between restarts.
SESSION_SECRET=
