# Optional GitHub PAT for local development only. Copy this file to .env.local.
# Ignored in production and on Vercel. Never use a NEXT_PUBLIC_ variable for tokens.
GITHUB_TOKEN=

# Optional Anthropic API key. Enables the Claude Haiku 4.5 ranking pass that
# reorders commits by how funny their subject lines are; without it the built-in
# heuristic ranking is used on its own. Only subject lines are sent to the API,
# never commit bodies, author names, repository names or URLs.
OPENAI_API_KEY=